# ---- Deploy (VPS + Traefik) ----
APP_DOMAIN="contrato.v3app.com.br"
TRAEFIK_NETWORK="traefik"          # nome da rede docker do Traefik já existente
TRAEFIK_CERTRESOLVER="letsencrypt" # nome do certresolver configurado no Traefik

# ---- Banco ----
# Supabase restaurado:
DATABASE_URL="postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://...supabase.com:5432/postgres"
# ou Postgres na própria VPS (perfil db do compose):
# DATABASE_URL="postgresql://contratoia:SENHA@postgres:5432/contratoia"
# DIRECT_URL="postgresql://contratoia:SENHA@postgres:5432/contratoia"
POSTGRES_USER="contratoia"
POSTGRES_PASSWORD=""
POSTGRES_DB="contratoia"

# ---- Sessão / Auth ----
SESSION_SECRET=""                  # openssl rand -base64 32
NEXT_PUBLIC_APP_URL="https://contrato.v3app.com.br"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- IA ----
AI_PROVIDER="local"                # local | groq
LOCAL_LLM_URL="http://10.0.2.1:11434"   # gateway da rede coolify (Ollama roda no host)
LOCAL_LLM_MODEL="gemma4-e2b-fast:latest"
LOCAL_LLM_API_KEY=""
LOCAL_LLM_TIMEOUT_MS="600000"          # ~14 tok/s: contrato leva 3-4 min
LOCAL_LLM_MAX_TOKENS="4096"
LOCAL_LLM_NUM_CTX="8192"
LOCAL_LLM_API="ollama"                 # ollama | openai | auto
AI_FALLBACK_GROQ="false"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_API_KEY=""

# ---- Pagamento ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- E-mail (Gmail SMTP, usado no "esqueci minha senha") ----
GMAIL_USER=""
GMAIL_APP_PASSWORD=""            # senha de app do Google, nao a da conta
